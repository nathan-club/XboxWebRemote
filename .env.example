XWR_IMAGE=
# 填写 Actions 发布的完整引用，例如 ghcr.io/owner/repository@sha256:...
XWR_ACCESS_USER=xbox
XWR_ACCESS_PASSWORD=
# HTTPS 网页的实际 origin，末尾不含路径。
XWR_PUBLIC_ORIGIN=https://xbox.example.com
# 默认只发布到 NAS 本机；反向代理在另一台机器时填写 NAS 的具体内网地址。
XWR_BIND_ADDRESS=127.0.0.1

# 可选媒体中继；地址和共享密钥只填写在私有部署环境。
# 可选 STUN 地址，用逗号分隔。默认不请求第三方 STUN。
XWR_STUN_URLS=
XWR_TURN_URL=
# 可选：容器内的地址文件路径；配置后优先于固定地址，需自行只读挂载其目录。
XWR_TURN_URL_FILE=
XWR_TURN_SECRET=
XWR_FORCE_RELAY=0
# 单位 kbps；0 使用主机默认码率。
XWR_VIDEO_BITRATE=0
